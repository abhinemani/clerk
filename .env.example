# --- Database (turnkey) ---------------------------------------------------
# Leave BOTH unset for a zero-config embedded DB:
#   local dev → persists to ./.pgdata ; Vercel → in-memory (set DATABASE_URL there)
#
# Managed Postgres (Neon / Vercel Postgres) — enables production persistence + pgvector:
# DATABASE_URL=postgres://user:pass@host/db
#
# Embedded PGlite persistent path (e.g. a mounted volume on Railway/Fly):
# PGLITE_PATH=/data/pgdata

# --- AI (optional; UI runs on demo data without it) -----------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ingestion API --------------------------------------------------------
# Dev key for POST /api/v1/{agency}/records (Authorization: Bearer ...)
# (fixed to "dev-ingest-key" in the prototype)
