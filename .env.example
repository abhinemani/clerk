# --- Database (turnkey) ---------------------------------------------------
# Leave BOTH unset for a zero-config embedded DB:
#   local dev → persists to ./.pgdata ; Vercel → in-memory (set DATABASE_URL there)
#
# Managed Postgres (Neon / Vercel Postgres) — enables production persistence + pgvector:
# DATABASE_URL=postgres://user:pass@host/db
#
# Embedded PGlite persistent path (e.g. a mounted volume on Railway/Fly):
# PGLITE_PATH=/data/pgdata

# --- AI (optional; UI runs on demo data without it) -----------------------
# ANTHROPIC_API_KEY=sk-ant-...

# --- Ingestion API --------------------------------------------------------
# Dev key for POST /api/v1/{agency}/records (Authorization: Bearer ...)
# (fixed to "dev-ingest-key" in the prototype)

# --- Auth ------------------------------------------------------------------
# Session-signing secret for Auth.js. REQUIRED in production (any long random
# string); dev falls back to a fixed insecure value.
# AUTH_SECRET=

# Platform operator (cross-tenant console at /admin). Dev defaults:
# admin@brandeis.example / brandeis-admin-dev. In production the dev defaults
# never work: set BOTH or platform sign-in stays disabled (tenant portals and
# workspaces are unaffected).
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=

# Embeddings (optional): real semantic search/dedup when set; fake vectors otherwise.
# VOYAGE_API_KEY=

# --- OCR (optional; scans/photos stay text-less without it) ----------------
# Text extraction is built in for text files, PDF text layers, and DOCX.
# Scanned/image documents need an OCR engine — set ONE of:
#
# A local tesseract binary (brew install tesseract / apt install tesseract-ocr),
# spoken to over stdin/stdout — fully self-contained:
# TESSERACT_PATH=tesseract
#
# Or a tesseract HTTP sidecar for container deploys (e.g. hertzg/tesseract-server;
# `docker run -p 8884:8884 hertzg/tesseract-server` then point at its endpoint):
# OCR_ENDPOINT=http://localhost:8884/tesseract
#
# Languages for either engine (tesseract "+"-separated codes; default eng):
# OCR_LANGS=eng

# --- File storage (turnkey, like the database) ----------------------------
# Blobs persist to BLOB_PATH (mount a volume in production, e.g. /data/blobs);
# defaults to ./.blobdata locally. S3/MinIO adapter slots in behind the same
# BlobStore port when needed.
# BLOB_PATH=

# --- Email (optional; the outbox at /[agency]/app/outbox is the mailbox
# either way — delivery is an upgrade, the outbox record is the audit) ------
# Outbound delivery: set EMAIL_FROM plus ONE provider key.
# EMAIL_FROM="Records Office <records@your-city.gov>"
# POSTMARK_SERVER_TOKEN=
# RESEND_API_KEY=
#
# Inbound email-in (§6.5): point your provider's inbound webhook at
# POST /api/v1/email/inbound with `Authorization: Bearer $INBOUND_EMAIL_TOKEN`.
# INBOUND_EMAIL_DOMAIN is the domain of the Reply-To ingest addresses
# (task-{token}@… / req-{uuid}@…). Endpoint 404s until the token is set.
# INBOUND_EMAIL_TOKEN=
# INBOUND_EMAIL_DOMAIN=in.your-city.gov

# --- Public base URL (used in emailed links) -------------------------------
# APP_BASE_URL=http://localhost:3000

# --- Self-service jurisdiction signup (/signup) ------------------------------
# On by default. "off" hides the page — the platform console (/admin) becomes
# the only way to onboard an agency.
# SELF_SIGNUP=off
# Signup requires a government email (.gov, .mil, or state/local .us). Set to
# "true" on self-hosted/demo deployments where that check doesn't apply.
# SIGNUP_ALLOW_ANY_EMAIL=true

# --- S3/MinIO blob storage (optional — local filesystem is the default) ------
# All four required to activate; path-style requests, SigV4 signed in-process.
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=brandeis-blobs
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# --- Search index (optional) -------------------------------------------------
# Search works with ZERO services: the built-in index is real BM25 with ask-
# alias boosting. Set these only to route ranking through an existing
# Elasticsearch/OpenSearch cluster; if it is unreachable, search silently
# falls back to built-in rather than failing.
# ELASTICSEARCH_URL=http://localhost:9200
# ELASTICSEARCH_INDEX=brandeis-records
# ELASTICSEARCH_API_KEY=

# --- Connected data sources (docs/connected-sources.md) ----------------------
# Where file-drop sources look for CSV slices. Each agency gets its OWN
# subdirectory ({CONNECTED_DROP_PATH}/{agencyId}) which the admin page
# displays — the path is never typed by a tenant admin, so one tenant can
# never point a connector at another's files. Defaults to ./.connected-drop.
# CONNECTED_DROP_PATH=/data/connected-drop
#
# Private HTTP/Socrata feeds: the source stores the NAME of an env var, never
# the token. Set the variable here with whatever name you gave the source —
# e.g. a source configured with tokenEnv=CITY_PORTAL_TOKEN reads:
# CITY_PORTAL_TOKEN=
