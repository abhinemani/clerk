# Postgres (with pgvector extension). Local dev default.
DATABASE_URL=postgres://localhost:5432/clerk

# Anthropic API — used by the AI pipelines (Phase 2+).
ANTHROPIC_API_KEY=

# Object storage (S3 in prod; MinIO/local-disk adapter in dev).
S3_ENDPOINT=
S3_BUCKET=clerk-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Transactional email provider (console adapter in dev).
EMAIL_PROVIDER=console
