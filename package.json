{
  "name": "clerk",
  "version": "0.1.0",
  "private": true,
  "description": "Clerk \u2014 an AI-native public records request platform",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "eval": "RUN_LIVE_EVALS=1 vitest run evals/",
    "duedate": "tsx scripts/duedate.ts",
    "triage": "tsx scripts/triage.ts",
    "seed": "tsx scripts/seed.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electric-sql/pglite": "^0.2.17",
    "drizzle-orm": "^0.36.4",
    "next": "^15.1.2",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
